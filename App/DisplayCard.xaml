<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ScreenBrightnessApp.DisplayCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="CardBody" Padding="24,22,24,12" Spacing="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                        <Grid Width="30" Height="28">
                            <Border Height="21" BorderThickness="1.5" BorderBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="3" VerticalAlignment="Top">
                                <TextBlock x:Name="DisplayNumberText" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="2" Height="5" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            <Border Width="13" Height="1.5" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="DisplayNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DisplayMetaText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border x:Name="PrimaryBadge" Grid.Column="2" VerticalAlignment="Center" Padding="9,4" CornerRadius="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="主显示器" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </Grid>
                <Grid>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="亮度" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ModeDescriptionText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ValueText" Text="—" FontFamily="Segoe UI Variable Display" FontSize="38" FontWeight="SemiBold"/>
                        <TextBlock Text="%" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="14" Margin="0,-8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE706;" FontSize="14" Opacity="0.6" VerticalAlignment="Center"/>
                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="1" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10" IsThumbToolTipEnabled="True" VerticalAlignment="Center"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE706;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            <Border x:Name="CardFooter" Grid.Row="1" Padding="24,14,24,18" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ModeCombo" Width="204" HorizontalAlignment="Left" AutomationProperties.Name="调光方式">
                            <ComboBoxItem x:Name="DdcOption" Content="硬件背光 · DDC/CI"/>
                            <ComboBoxItem Content="软件调光 · Gamma"/>
                        </ComboBox>
                        <Button x:Name="ResetButton" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="恢复初始亮度" ToolTipService.ToolTip="恢复已记录的初始亮度">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="14"/>
                                <TextBlock x:Name="ResetLabel" Text="恢复初始亮度"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" FontSize="11" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
