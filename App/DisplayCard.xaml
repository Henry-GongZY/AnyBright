<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ScreenBrightnessApp.DisplayCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel Padding="12" Spacing="5">
            <Grid ColumnSpacing="9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid Width="21" Height="21">
                        <Border Height="16" BorderThickness="1" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="2" VerticalAlignment="Top">
                            <TextBlock x:Name="DisplayNumberText" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="1" Height="4" Background="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        <Border Width="10" Height="1" Background="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="DisplayNameText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DisplayMetaText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ToggleButton x:Name="DetailsButton" Grid.Column="2" Width="28" Height="28" Padding="0" Background="Transparent" BorderBrush="Transparent"
                              Click="OnDetailsClick" AutomationProperties.Name="显示器调光选项" ToolTipService.ToolTip="调光方式与恢复">
                    <FontIcon x:Name="DetailsChevron" Glyph="&#xE70D;" FontSize="10"/>
                </ToggleButton>
            </Grid>
            <Grid ColumnSpacing="9" Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE706;" FontSize="15" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" MinWidth="43" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ValueText" Text="—" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Spacing="10" Margin="0,6,0,2">
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" FontSize="12" AutomationProperties.Name="调光方式">
                        <ComboBoxItem x:Name="DdcOption" Content="硬件背光 · DDC/CI"/>
                        <ComboBoxItem Content="软件调光 · Gamma"/>
                    </ComboBox>
                    <Button x:Name="ResetButton" Grid.Column="1" Width="32" Height="32" Padding="0" AutomationProperties.Name="恢复初始亮度" ToolTipService.ToolTip="恢复初始亮度">
                        <FontIcon Glyph="&#xE777;" FontSize="14"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="ModeDescriptionText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Grid x:Name="StatusRow" Visibility="Collapsed" ColumnSpacing="5" Margin="0,3,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" FontSize="10" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
