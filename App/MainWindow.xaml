<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ScreenBrightnessApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="屏幕亮度">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Height="40" Background="Transparent" Padding="20,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE706;" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                <TextBlock Text="屏幕亮度" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="ContentGrid" Grid.Row="1" Padding="32,24,32,20" RowSpacing="24" MaxWidth="920" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="屏幕亮度" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="IntroSubtitle" Text="独立调节每一块屏幕，为此刻找到舒适的亮度。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                <Button Width="36" Height="36" Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="外观" ToolTipService.ToolTip="外观">
                    <FontIcon Glyph="&#xE790;" FontSize="18"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem x:Name="SystemThemeItem" Text="跟随系统" Tag="system" GroupName="Theme" Click="OnThemeClick" IsChecked="True"/>
                            <RadioMenuFlyoutItem x:Name="LightThemeItem" Text="浅色" Tag="light" GroupName="Theme" Click="OnThemeClick"/>
                            <RadioMenuFlyoutItem x:Name="DarkThemeItem" Text="深色" Tag="dark" GroupName="Theme" Click="OnThemeClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Width="36" Height="36" Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="调光帮助" ToolTipService.ToolTip="了解调光方式">
                    <FontIcon Glyph="&#xE897;" FontSize="18"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel MaxWidth="310" Spacing="12">
                                <TextBlock Text="选择适合的调光方式" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="硬件背光" FontWeight="SemiBold"/>
                                <TextBlock Text="通过 DDC/CI 调节显示器自身的背光。需要在显示器菜单中开启 DDC/CI。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="软件调光" FontWeight="SemiBold"/>
                                <TextBlock Text="通过 Gamma 调整输出画面的亮度。开启 HDR 时可能无效；较低亮度可能受 Windows 限制。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="恢复初始亮度可还原已记录的调光基线。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="显示器" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DisplayCountText" Text="正在检测" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="CardsPanel" Spacing="16" Padding="0,0,4,4">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True"/></TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <StackPanel x:Name="LoadingPanel" Padding="24,52" Spacing="16" HorizontalAlignment="Center">
                            <ProgressRing x:Name="LoadingRing" IsActive="True" Width="28" Height="28"/>
                            <TextBlock Text="正在连接你的显示器…" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Padding="24,40" Spacing="12" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7F4;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="EmptyTitle" Text="暂未发现显示器" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyMessage" Text="请确认显示器已连接，然后重新检测。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="重新检测" Click="OnRetryClick" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="2" Spacing="12">
                <InfoBar x:Name="UnlockInfoBar" IsOpen="False" Severity="Warning" IsClosable="True" Title="已达到 Windows 调光下限" Message="更低的软件亮度需要解除系统限制，并重新打开应用。">
                    <InfoBar.ActionButton><Button Content="解除限制" Click="OnUnlockClick"/></InfoBar.ActionButton>
                </InfoBar>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9CE;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="调整即时生效 · 自动记住调光方式" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
