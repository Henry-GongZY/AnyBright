<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ScreenBrightnessApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AnyBright">
    <Border x:Name="PanelBorder" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderGrid" Padding="18,14,12,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="AnyBright" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DisplayCountText" Text="正在连接显示器…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Width="32" Height="32" Padding="0" Style="{StaticResource QuietButtonStyle}"
                        AutomationProperties.Name="设置" ToolTipService.ToolTip="设置">
                    <Image x:Name="GearImg" Width="16" Height="16" Source="ms-appx:///assets/settings-light.png"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="外观主题" IsEnabled="False"/>
                            <RadioMenuFlyoutItem x:Name="SystemThemeItem" Text="跟随系统" Tag="system" GroupName="Theme" Click="OnThemeClick" IsChecked="True"/>
                            <RadioMenuFlyoutItem x:Name="LightThemeItem" Text="浅色" Tag="light" GroupName="Theme" Click="OnThemeClick"/>
                            <RadioMenuFlyoutItem x:Name="DarkThemeItem" Text="深色" Tag="dark" GroupName="Theme" Click="OnThemeClick"/>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Name="AutoStartItem" Text="开机后静默驻留托盘" Click="OnAutoStartClick"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="RefreshItem" Text="重新检测显示器" Click="OnRetryClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" Padding="12,0,12,4">
                <StackPanel x:Name="CardsPanel" Spacing="8" SizeChanged="OnContentSizeChanged">
                    <StackPanel x:Name="LoadingPanel" Padding="20,28" Spacing="12" HorizontalAlignment="Center">
                        <ProgressRing x:Name="LoadingRing" IsActive="True" Width="24" Height="24"/>
                        <TextBlock Text="正在读取亮度…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Padding="16,24" Spacing="10">
                        <TextBlock x:Name="EmptyTitle" Text="暂未发现显示器" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyMessage" Text="请确认显示器已连接，然后重新检测。" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="重新检测" Click="OnRetryClick" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="FooterBorder" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,0,0">
                        <FontIcon Glyph="&#xE706;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="轻量模式" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource QuietButtonStyle}" Width="32" Height="32" Padding="0" AutomationProperties.Name="调光帮助" ToolTipService.ToolTip="调光帮助">
                        <Image x:Name="HelpImg" Width="16" Height="16" Source="ms-appx:///assets/help-light.png"/>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel MaxWidth="270" Spacing="10">
                                    <TextBlock Text="屏幕亮度，随手调节" FontWeight="SemiBold"/>
                                    <TextBlock Text="硬件背光 · DDC/CI" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="直接调节显示器背光。需要在显示器菜单中开启 DDC/CI。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="软件调光 · Gamma" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="压暗输出画面。滑块 0–100 对应系统允许的 50%–100% 范围；HDR 开启时可能无效。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="点击显示器右侧箭头可切换调光方式或恢复初始亮度。点击面板外部或按 Esc 收起，亮度保持不变。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource QuietButtonStyle}" Height="32" Click="OnExitClick" AutomationProperties.Name="退出 AnyBright">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7E8;" FontSize="14"/>
                            <TextBlock Text="退出" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
